{
  "name": "senegal-mohebs-tlm-server",
  "version": "0.4.0",
  "description": "MCP server: shared memory for generating Senegalese MOHEBS teaching & learning materials across grades and subjects. Local sources are organised per grade/subject; Firebase Storage holds generated documents and a per-context history that caches extracted content so tracked documents are never re-parsed.",
  "type": "module",
  "bin": {
    "senegal-mohebs-tlm-server": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/check-cycles.mjs && npx tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:cycles": "node scripts/check-cycles.mjs",
    "test": "vitest run",
    "start:http": "node dist/http.js",
    "seed:kg-store": "npm run build && node scripts/seed-kg-store.mjs",
    "parity:kg-store": "npm run build && node scripts/parity-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.4",
    "mammoth": "^1.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}