{
  "hosting": {
    "public": "frontend/explorer/dist",
    "predeploy": [
      "npm --prefix frontend/explorer ci",
      "npm --prefix frontend/explorer run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/kg/**",
        "run": { "serviceId": "senegal-mohebs-tlm", "region": "europe-west1" }
      },
      {
        "source": "/kg",
        "run": { "serviceId": "senegal-mohebs-tlm", "region": "europe-west1" }
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ]
  }
}
